<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- =================================================================================== -->
  <!-- |                       SIMPLE PARALLEL GRIPPER MACRO                             | -->
  <!-- =================================================================================== -->
  <!--
    This macro creates a simple two-finger parallel gripper.
    - It's controlled by a single "master" joint: 'left_finger_joint'.
    - The 'right_finger_joint' uses a <mimic> tag to move symmetrically.

    Params:
    - name_prefix: A prefix for all links and joints to prevent name collisions.
    - parent_link: The name of the link on your robot to attach the gripper to.
    - *origin:     An <origin> block to define the xyz/rpy of the attachment point.
  -->
  <xacro:macro name="simple_gripper" params="name_prefix parent_link *origin">

    <!-- Gripper Base Link -->
    <!-- This is the static part of the gripper that attaches to the robot arm. -->
    <link name="${name_prefix}base_link">
      <visual>
        <geometry><box size="0.05 0.1 0.05"/></geometry>
        <material name="grey"/>
      </visual>
      <collision>
        <geometry><box size="0.05 0.1 0.05"/></geometry>
      </collision>
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="0.000041" ixy="0" ixz="0" iyy="0.000041" iyz="0" izz="0.000083"/>
      </inertial>
    </link>

    <!-- Joint to attach the gripper base to the parent link -->
    <joint name="${name_prefix}base_joint" type="fixed">
      <parent link="${parent_link}"/>
      <child link="${name_prefix}base_link"/>
      <xacro:insert_block name="origin"/>
    </joint>

    <!-- Left Finger (Master) -->
    <!-- This finger's joint is the one you will control directly. -->
    <link name="${name_prefix}left_finger_link">
      <visual>
        <geometry><box size="0.02 0.01 0.1"/></geometry>
        <material name="blue"/>
      </visual>
      <collision>
        <geometry><box size="0.02 0.01 0.1"/></geometry>
      </collision>
      <inertial>
        <mass value="0.02"/>
        <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.000001"/>
      </inertial>
    </link>

    <joint name="${name_prefix}left_finger_joint" type="prismatic">
      <parent link="${name_prefix}base_link"/>
      <child link="${name_prefix}left_finger_link"/>
      <!-- The finger starts offset from the center of the base -->
      <origin xyz="0 0.045 -0.025" rpy="0 0 0"/>
      <!-- It moves outwards along the positive Y-axis -->
      <axis xyz="0 1 0"/>
      <!-- 'lower=0' is closed, 'upper=0.03' is open -->
      <limit lower="0.0" upper="0.03" effort="20" velocity="0.5"/>
    </joint>

    <!-- Right Finger (Slave) -->
    <!-- This finger mimics the left one to create symmetric motion. -->
    <link name="${name_prefix}right_finger_link">
      <visual>
        <geometry><box size="0.02 0.01 0.1"/></geometry>
        <material name="blue"/>
      </visual>
      <collision>
        <geometry><box size="0.02 0.01 0.1"/></geometry>
      </collision>
      <inertial>
        <mass value="0.02"/>
        <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.000001"/>
      </inertial>
    </link>

    <joint name="${name_prefix}right_finger_joint" type="prismatic">
      <parent link="${name_prefix}base_link"/>
      <child link="${name_prefix}right_finger_link"/>
      <!-- This finger starts on the opposite side of the base -->
      <origin xyz="0 -0.045 -0.025" rpy="0 0 0"/>
      <!-- It moves outwards along the negative Y-axis -->
      <axis xyz="0 -1 0"/>
      <limit lower="0.0" upper="0.03" effort="20" velocity="0.5"/>
      <!-- The MIMIC tag is the key: it makes this joint copy the master joint's value -->
      <mimic joint="${name_prefix}left_finger_joint" multiplier="1" offset="0"/>
    </joint>

  </xacro:macro>
</robot>