<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- =================================================================================== -->
  <!-- |                              ROS2 CONTROL MACRO                                 | -->
  <!-- =================================================================================== -->
  
  <xacro:macro name="parallel_beam_gantry_ros2_control" params="name use_mock_hardware:=false use_sim:=false">
    
    <ros2_control name="${name}" type="system">
      
      <!-- Hardware Interface Selection -->
      <xacro:if value="${use_mock_hardware}">
        <hardware>
          <plugin>mock_components/GenericSystem</plugin>
          <param name="mock_sensor_commands">false</param>
          <param name="state_following_offset">0.0</param>
        </hardware>
      </xacro:if>
      
      <xacro:if value="${use_sim}">
        <hardware>
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>
      </xacro:if>
      
      <xacro:unless value="${use_mock_hardware or use_sim}">
        <hardware>
          <!-- Replace with your actual hardware interface plugin -->
          <plugin>parallel_beam_gantry_hardware/ParallelBeamGantrySystemHardware</plugin>
          <param name="example_param">example_value</param>
        </hardware>
      </xacro:unless>

      <!-- ============================================================================= -->
      <!-- |                            X-AXIS JOINT                                   | -->
      <!-- ============================================================================= -->
      
      <joint name="x_slider_joint">
        <command_interface name="position">
          <param name="min">-0.95</param>
          <param name="max">0.95</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>

      <!-- ============================================================================= -->
      <!-- |                            Y-AXIS JOINT                                   | -->
      <!-- ============================================================================= -->
      
      <joint name="y_slider_joint">
        <command_interface name="position">
          <param name="min">-0.45</param>
          <param name="max">0.45</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>

      <!-- ============================================================================= -->
      <!-- |                            Z-AXIS JOINT                                   | -->
      <!-- ============================================================================= -->
      
      <joint name="z_slider_joint">
        <command_interface name="position">
          <param name="min">-0.22</param>
          <param name="max">0.22</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>
      <!-- Gripper Joint -->
      <joint name="left_finger_joint">
        <command_interface name="position">
          <param name="min">0</param>
          <param name="max">0.03</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      

      <!-- ============================================================================= -->
      <!-- |                         MIMIC JOINT (PASSIVE)                             | -->
      <!-- ============================================================================= -->
      <!-- 
        Note: The x_slider_mimic_joint is a mimic joint and typically doesn't need
        ros2_control interfaces. It will follow x_slider_joint automatically.
        If your hardware plugin needs to control it separately, uncomment below:
      -->
      <!--
      <joint name="x_slider_mimic_joint">
        <param name="mimic">x_slider_joint</param>
        <param name="multiplier">1.0</param>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      -->
      

    </ros2_control>
    
  </xacro:macro>

</robot>