<!-- =================================================================================== -->
  <!-- |                                  ROS2 CONTROL                                   | -->
  <!-- =================================================================================== -->
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <!-- This plugin connects ros2_control to the Gazebo simulator -->
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>

    <!-- Define the X-axis joint for control -->
    <joint name="x_slider_joint">
      <command_interface name="position">
        <param name="min">-0.95</param>
        <param name="max">0.95</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- Define the Y-axis joint for control -->
    <joint name="y_slider_joint">
      <command_interface name="position">
        <param name="min">-0.45</param>
        <param name="max">0.45</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- Define the Z-axis joint for control -->
    <joint name="z_slider_joint">
      <command_interface name="position">
        <param name="min">-0.22</param>
        <param name="max">0.22</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!--
      NOTE: The mimic joint 'x_slider_mimic_joint' is not listed here for command.
      The <mimic> tag in the joint definition itself is sufficient for ros2_control
      and Gazebo to enforce the mimic behavior automatically. We only need to control
      the main 'x_slider_joint'.
    -->

  </ros2_control>