<?xml version="1.0"?>
<robot name="parallel_beam_gantry">

  <!-- =================================================================================== -->
  <!-- |                                     BASE                                        | -->
  <!-- =================================================================================== -->

  <!-- World Link: The static origin of the entire robot model -->
  <link name="world" />


  <!-- =================================================================================== -->
  <!-- |                         X-AXIS GANTRY STRUCTURE (FIXED)                         | -->
  <!-- =================================================================================== -->

  <!-- First parallel beam, mounted 2m high -->
  <link name="parallel_beam_1_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="2.0 0.05 0.05"/></geometry>
      <material name="grey"><color rgba="0.5 0.5 0.5 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="2.0 0.05 0.05"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="2.0"/>
      <inertia ixx="0.000833" ixy="0.0" ixz="0.0" iyy="0.667083" iyz="0.0" izz="0.667083"/>
    </inertial>
  </link>
  <joint name="world_to_beam_1_joint" type="fixed">
    <parent link="world"/>
    <child link="parallel_beam_1_link"/>
    <origin xyz="0 0.5 2.0" rpy="0 0 0"/>
  </joint>

  <!-- Second parallel beam, mounted 2m high -->
  <link name="parallel_beam_2_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="2.0 0.05 0.05"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="2.0 0.05 0.05"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="2.0"/>
      <inertia ixx="0.000833" ixy="0.0" ixz="0.0" iyy="0.667083" iyz="0.0" izz="0.667083"/>
    </inertial>
  </link>
  <joint name="world_to_beam_2_joint" type="fixed">
    <parent link="world"/>
    <child link="parallel_beam_2_link"/>
    <origin xyz="0 -0.5 2.0" rpy="0 0 0"/>
  </joint>


  <!-- =================================================================================== -->
  <!-- |                       X-AXIS MOTION ASSEMBLY (MOVES ON X)                       | -->
  <!-- =================================================================================== -->

  <!-- Master slider for the X-axis -->
  <link name="x_slider_1_link">
    <visual>
      <geometry><box size="0.1 0.1 0.1"/></geometry>
      <material name="blue"><color rgba="0 0 0.8 1.0"/></material>
    </visual>
    <collision><geometry><box size="0.1 0.1 0.1"/></geometry></collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.000333" ixy="0.0" ixz="0.0" iyy="0.000333" iyz="0.0" izz="0.000333"/>
    </inertial>
  </link>
  <joint name="x_slider_joint" type="prismatic">
    <parent link="parallel_beam_1_link"/>
    <child link="x_slider_1_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.95" upper="0.95" effort="100" velocity="1.0"/>
  </joint>

  <!-- Slave slider for the X-axis (mimics the master) -->
  <link name="x_slider_2_link">
    <visual>
      <geometry><box size="0.1 0.1 0.1"/></geometry>
      <material name="blue"/>
    </visual>
    <collision><geometry><box size="0.1 0.1 0.1"/></geometry></collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.000333" ixy="0.0" ixz="0.0" iyy="0.000333" iyz="0.0" izz="0.000333"/>
    </inertial>
  </link>
  <joint name="x_slider_mimic_joint" type="prismatic">
    <parent link="parallel_beam_2_link"/>
    <child link="x_slider_2_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.95" upper="0.95" effort="100" velocity="1.0"/>
    <mimic joint="x_slider_joint" multiplier="1" offset="0"/>
  </joint>


  <!-- =================================================================================== -->
  <!-- |                     Y-AXIS CARRIAGE ASSEMBLY (MOVES ON X)                       | -->
  <!-- =================================================================================== -->

  <!-- Cross beam that spans the gantry and acts as the rail for the Y-axis -->
  <link name="cross_beam_link">
    <visual>
      <geometry><box size="0.05 1.0 0.05"/></geometry>
      <material name="red"><color rgba="1.0 0 0 1.0"/></material>
    </visual>
    <collision><geometry><box size="0.05 1.0 0.05"/></geometry></collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.083542" ixy="0.0" ixz="0.0" iyy="0.000417" iyz="0.0" izz="0.083542"/>
    </inertial>
  </link>
  <joint name="cross_beam_attachment_joint" type="fixed">
    <parent link="x_slider_1_link"/>
    <child link="cross_beam_link"/>
    <origin xyz="0 -0.5 0.1" rpy="0 0 0"/>
  </joint>

  <!-- Slider for the Y-axis (moves along the red cross beam) -->
  <link name="y_slider_link">
    <visual>
      <geometry><box size="0.1 0.1 0.1"/></geometry>
      <material name="green"><color rgba="0 1.0 0 1.0"/></material>
    </visual>
    <collision><geometry><box size="0.1 0.1 0.1"/></geometry></collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.000333" ixy="0.0" ixz="0.0" iyy="0.000333" iyz="0.0" izz="0.000333"/>
    </inertial>
  </link>
  <joint name="y_slider_joint" type="prismatic">
    <parent link="cross_beam_link"/>
    <child link="y_slider_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.45" upper="0.45" effort="100" velocity="1.0"/>
  </joint>


  <!-- =================================================================================== -->
  <!-- |                       Z-AXIS ACTUATOR ASSEMBLY (MOVES ON Y)                     | -->
  <!-- =================================================================================== -->

  <!-- Vertical beam that acts as the rail for the Z-axis -->
  <link name="vertical_beam_link">
    <visual>
      <geometry><box size="0.04 0.04 0.5"/></geometry>
      <material name="orange"><color rgba="1.0 0.5 0.0 1.0"/></material>
    </visual>
    <collision><geometry><box size="0.04 0.04 0.5"/></geometry></collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.010533" ixy="0.0" ixz="0.0" iyy="0.010533" iyz="0.0" izz="0.000133"/>
    </inertial>
  </link>
  <joint name="vertical_beam_attachment_joint" type="fixed">
    <parent link="y_slider_link"/>
    <child link="vertical_beam_link"/>
    <origin xyz="0 0 -0.3" rpy="0 0 0"/>
  </joint>
  
  <!-- Slider for the Z-axis, now a wider mounting plate -->
  <link name="z_slider_link">
    <visual>
      <!-- Made wider (in X) to act as a mounting plate -->
      <geometry><box size="0.12 0.06 0.06"/></geometry>
      <material name="purple"><color rgba="0.5 0 0.8 1.0"/></material>
    </visual>
    <collision><geometry><box size="0.12 0.06 0.06"/></geometry></collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <!-- Inertia recalculated for a 0.12x0.06x0.06 box -->
      <inertia ixx="0.00012" ixy="0.0" ixz="0.0" iyy="0.0003" iyz="0.0" izz="0.0003"/>
    </inertial>
  </link>
  <joint name="z_slider_joint" type="prismatic">
    <parent link="vertical_beam_link"/>
    <child link="z_slider_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.22" upper="0.22" effort="100" velocity="1.0"/>
  </joint>


  <!-- =================================================================================== -->
  <!-- |                          END EFFECTOR (MOVES ON Z)                              | -->
  <!-- =================================================================================== -->

  <!-- The final link, a vertical 0.5m beam, where a tool would be attached -->
  <link name="end_effector_link">
    <visual>
      <!-- Beam is 0.5m long, pointing down along the Z-axis -->
      <geometry>
        <box size="0.04 0.04 0.5"/>
      </geometry>
      <material name="cyan">
        <color rgba="0 1.0 1.0 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.04 0.04 0.5"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.4"/>
      <!-- Inertia recalculated for a 0.04x0.04x0.5 box -->
      <inertia ixx="0.008387" ixy="0.0" ixz="0.0" iyy="0.008387" iyz="0.0" izz="0.000107"/>
    </inertial>
  </link>
  <joint name="end_effector_attachment_joint" type="fixed">
    <parent link="z_slider_link"/>
    <child link="end_effector_link"/>
    <origin xyz="0.06 0 -0.28" rpy="0 0 0"/>
  </joint>

    
</robot>