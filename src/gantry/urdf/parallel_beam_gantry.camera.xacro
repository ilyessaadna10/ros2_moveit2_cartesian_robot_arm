<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:macro name="overhead_rgb_camera" params="*origin name_prefix parent:=world">

  <link name="${name_prefix}_camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.04 0.04 0.04"/></geometry>
      <material name="black"><color rgba="0.1 0.1 0.1 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.04 0.04 0.04"/></geometry>
    </collision>
    <inertial>
      <mass value="0.06"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <joint name="${name_prefix}_camera_joint" type="fixed">
    <parent link="${parent}"/>
    <child link="${name_prefix}_camera_link"/>
    <xacro:insert_block name="origin"/>
  </joint>

  <link name="${name_prefix}_camera_optical_link"/>
  <joint name="${name_prefix}_camera_optical_joint" type="fixed">
    <parent link="${name_prefix}_camera_link"/>
    <child link="${name_prefix}_camera_optical_link"/>
    <origin xyz="0 0 0" rpy="-1.570796 0 -1.570796"/>
  </joint>

  <!-- Gazebo Harmonic sensor definition -->
  <gazebo reference="${name_prefix}_camera_link">
    <sensor name="${name_prefix}_rgb_sensor" type="camera">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <visualize>true</visualize>
      <topic>/camera/${name_prefix}/image_raw</topic>
      <camera name="${name_prefix}_camera">
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>100</far>
        </clip>
        <optical_frame_id>${name_prefix}_camera_optical_link</optical_frame_id>
      </camera>
    </sensor>
  </gazebo>

</xacro:macro>

</robot>